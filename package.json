{
  "name": "baseline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm typecheck:root && pnpm -r typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:code && pnpm format:check && pnpm lint:deps",
    "lint:code": "rslint",
    "lint:deps": "depcruise apps packages services --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "rstest run"
  },
  "devDependencies": {
    "@rslint/core": "^0.9.4",
    "@rstest/core": "^0.12.3",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "expect-type": "^1.4.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
