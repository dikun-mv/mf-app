{
  "name": "baseline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "docker compose up -d --build --wait",
    "start:dev": "docker compose up -d --build --wait gateway people-pb delivery-pb && pnpm --filter './apps/*' --parallel dev",
    "stop": "docker compose down",
    "stop:clean": "docker compose down -v",
    "typecheck": "pnpm typecheck:root && pnpm -r typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:code && pnpm format:check && pnpm lint:deps",
    "lint:code": "rslint",
    "lint:deps": "depcruise apps packages services --config .dependency-cruiser.cjs",
    "graph": "depcruise apps packages services --config .dependency-cruiser.cjs --output-type mermaid --collapse '^(apps|packages|services)/[^/]+' --exclude 'node_modules|\\.test\\.tsx?$|/test/|/testing/|\\.d\\.ts$'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "rstest run",
    "test:integration": "rstest run --config rstest.integration.config.ts",
    "test:coverage": "rstest run --coverage"
  },
  "devDependencies": {
    "@rslint/core": "^0.9.4",
    "@rstest/adapter-rsbuild": "^0.12.3",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-istanbul": "^0.12.3",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "expect-type": "^1.4.0",
    "fast-check": "^4.10.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
